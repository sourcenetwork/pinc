+
+/// What the send queues hold for one session, for trace validation (cargo feature `trace`).
+#[cfg(feature = "trace")]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct QueueEntry {
+    /// The session slot.
+    pub slot: usize,
+    /// The slot is in use.
+    pub live: bool,
+    /// The slot's own mark: 0 not queued, 1 ordinary queue, 2 broadcast queue.
+    pub flag: u8,
+    /// The slot belongs to a broadcast session.
+    pub gossip: bool,
+    /// A sub-session open of the slot is still to leave.
+    pub ctrl_pending: bool,
+}
+
+#[cfg(feature = "trace")]
+ep_impl! {
+    /// Entry `k` (from 0, the front) of send queue `q` (0 ordinary, 1 broadcast), following the links from the head
+    /// (cargo feature `trace`).
+    #[must_use]
+    pub fn send_queue_at(&self, q: usize, k: usize) -> Option<QueueEntry> {
+        let mut cur = self.dirty_head.get(q).copied().unwrap_or(crate::slot::NIL);
+        let mut n = 0;
+        while let Some(s) = self.slots.get(cur as usize) {
+            if n == k {
+                return Some(QueueEntry {
+                    slot: cur as usize,
+                    live: s.m.in_use,
+                    flag: s.m.dirty,
+                    gossip: s.m.gossip,
+                    ctrl_pending: s.m.ctrl_pending,
+                });
+            }
+            n += 1;
+            cur = s.m.dirty_next;
+        }
+        None
+    }
+
+    /// The last slot of send queue `q` as the endpoint's tail pointer has it, `None` for none (cargo feature `trace`).
+    #[must_use]
+    pub fn send_queue_tail(&self, q: usize) -> Option<usize> {
+        let t = self.dirty_tail.get(q).copied()?;
+        self.slots.get(t as usize).map(|_| t as usize)
+    }
+
+    /// The datagram kept for the next call: its length and segment size, `None` for none (cargo feature `trace`).
+    #[must_use]
+    pub fn send_kept(&self) -> Option<(usize, usize)> {
+        self.stash_meta.map(|m| (m.len, m.segment))
+    }
+
+    /// What session slot `i` carries towards the send queues (cargo feature `trace`).
+    #[must_use]
+    pub fn send_mark(&self, i: usize) -> Option<QueueEntry> {
+        let s = self.slots.get(i)?;
+        Some(QueueEntry {
+            slot: i,
+            live: s.m.in_use,
+            flag: s.m.dirty,
+            gossip: s.m.gossip,
+            ctrl_pending: s.m.ctrl_pending,
+        })
+    }
+}

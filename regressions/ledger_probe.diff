+#[test]
+fn zz_probe_ledger_level() {
+    use vinc_core::Ledger;
+    let v: SocketAddr = "10.9.9.9:1000".parse().unwrap();
+    let mut l = Ledger::new(1);
+    l.on_receive(v, 1200);
+    assert!(l.allow_send(v, 1000));
+    l.on_receive(v, 1);
+    let e = l.get(&v).unwrap();
+    eprintln!("after the blind 1-byte datagram: {e:?}");
+    assert!(l.allow_send(v, 1_000_000));
+    let e = l.get(&v).unwrap();
+    eprintln!("after a 1_000_000-byte send: {e:?}; 3*rx = {}", 3 * e.rx);
+}
+
+#[test]
+fn zz_probe_unchecked_add() {
+    use vinc_core::Ledger;
+    let v: SocketAddr = "10.9.9.8:1000".parse().unwrap();
+    let mut l = Ledger::new(1);
+    l.on_receive(v, u64::MAX);
+    assert!(l.allow_send(v, u64::MAX - 28));
+    eprintln!("after the first send: {:?}", l.get(&v).unwrap());
+    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| l.allow_send(v, 0)));
+    eprintln!("second send: {r:?}");
+}
+
+#[test]
+fn zz_probe_unchecked_add_endpoint_sized() {
+    use vinc_core::Ledger;
+    // Only datagram-sized calls (at most 9216 bytes, the endpoint's MAX_DATAGRAM): receive while nothing was sent
+    // (the address stays unvalidated), then send without receiving.
+    let v: SocketAddr = "10.9.9.7:1000".parse().unwrap();
+    let mut l = Ledger::new(1);
+    let mut e = vinc_core::LedgerEntry { rx: 0, tx: 0, validated: false };
+    // Count how many receives and sends would be needed, by arithmetic only.
+    let per_rx = 9216u128;
+    let need_rx = (u128::from(u64::MAX) / 3 + 1).div_ceil(per_rx);
+    eprintln!("receives of 9216 bytes needed before 3*rx passes u64::MAX: {need_rx}");
+    l.on_receive(v, 9216);
+    e.rx = 9216;
+    let _ = e;
+}

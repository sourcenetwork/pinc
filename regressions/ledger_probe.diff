+#[test]
+fn zz_probe_spoofed_resume_plus_one_byte() {
+    big_stack(|| {
+        for gap_ms in [1u64, 5, 20, 100, 400] {
+            let (mut net, s, hello) = spoofable_resume();
+            let x: SocketAddr = "10.9.9.9:1000".parse().unwrap();
+            let to = net.nodes[s].addr;
+            let out0 = net.nodes[s].ep.node_stats().datagrams_out;
+            let tap0 = net.tapped.iter().filter(|t| t.1 == to).count();
+            net.inject(x, to, hello.clone(), 0);
+            net.run_for(gap_ms * MS_NS);
+            let out1 = net.nodes[s].ep.node_stats().datagrams_out;
+            let tap1 = net.tapped.iter().filter(|t| t.1 == to).count();
+            eprintln!("datagrams_out grew {} while {} datagrams reached the wire", out1 - out0, tap1 - tap0);
+            let Answer::Ledger(e0) = net.nodes[s].ep.query(Query::Ledger(x)) else { panic!() };
+            let sent0: u64 = net.tapped.iter().filter(|t| t.2 == x).map(|t| t.3 as u64 + 28).sum();
+            net.inject(x, to, vec![0x40], 0);
+            net.run_for(30 * SEC_NS);
+            let Answer::Ledger(e) = net.nodes[s].ep.query(Query::Ledger(x)) else { panic!() };
+            let sent: u64 = net.tapped.iter().filter(|t| t.2 == x).map(|t| t.3 as u64 + 28).sum();
+            let n: usize = net.tapped.iter().filter(|t| t.2 == x).count();
+            eprintln!(
+                "gap {gap_ms} ms: before the byte {e0:?} sent {sent0}; after: {e:?}; datagrams to x {n}, bytes (+28 each) {sent}, 3*rx {} held {}",
+                3 * e.rx,
+                net.nodes[s].ep.node_stats().held_by_ledger
+            );
+        }
+    });
+}

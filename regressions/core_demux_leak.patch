 crates/vinc-core/src/lib.rs      |   2 +
 tests/Cargo.toml                 |   4 +
 tests/core_demux_leak.rs         | 229 +++++++++++++++++++++++++++++++
 4 files changed, 289 insertions(+)
 create mode 100644 tests/core_demux_leak.rs

diff --git a/crates/vinc-core/src/endpoint.rs b/crates/vinc-core/src/endpoint.rs
index 35991fe..4ba4652 100644
--- a/crates/vinc-core/src/endpoint.rs
+++ b/crates/vinc-core/src/endpoint.rs
@@ -901,3 +901,57 @@ ep_impl! {
         self.mark_dirty(h as usize);
     }
 }
+
+/// What one slot holds of connection ids, for trace validation (cargo feature `trace`).
+#[cfg(feature = "trace")]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct CidRecord {
+    /// The slot holds a session.
+    pub in_use: bool,
+    /// The generation of the slot (the high half of its session id).
+    pub generation: u32,
+    /// The slot has a connection.
+    pub conn: bool,
+    /// The id the dialer invented, registered when a server session was made.
+    pub odcid: Option<ConnId>,
+    /// The ids registered for the connection at its last sync, in the order the connection listed them.
+    pub cids: [Option<ConnId>; MAX_CIDS],
+    /// The ids the connection accepts now (`Connection::local_cids`), in its order; none without a connection.
+    pub accepts: [Option<ConnId>; MAX_CIDS],
+}
+
+#[cfg(feature = "trace")]
+ep_impl! {
+    /// The demultiplexing table (cargo feature `trace`).
+    #[must_use]
+    pub const fn trace_demux(&self) -> &Table<ConnId, u32, D> {
+        &self.demux
+    }
+
+    /// What slot `i` holds of connection ids, `None` past the table (cargo feature `trace`).
+    #[must_use]
+    pub fn trace_cids(&self, i: usize) -> Option<CidRecord> {
+        let s = self.slots.get(i)?;
+        let mut accepts = [None; MAX_CIDS];
+        if let Some(c) = s.conn.as_ref() {
+            for (d, id) in accepts.iter_mut().zip(c.local_cids()) {
+                *d = Some(id);
+            }
+        }
+        Some(CidRecord {
+            in_use: s.m.in_use,
+            generation: s.m.generation,
+            conn: s.conn.is_some(),
+            odcid: s.m.odcid,
+            cids: s.m.cids,
+            accepts,
+        })
+    }
+
+    /// The authenticated session of `session`'s connection, once its handshake completed (cargo feature `trace`).
+    #[must_use]
+    pub fn trace_session(&self, session: SessionId) -> Option<&vinc_security::Established> {
+        let i = self.slot_of(session)?;
+        self.slots.get(i)?.conn.as_ref()?.session()
+    }
+}

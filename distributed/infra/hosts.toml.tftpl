# Written by `terraform apply` in distributed/infra; read by `vinc-distributed run --hosts <this file>`.
# Each machine: the address the harness reaches it on over SSH, the user, its region (the site name a scenario can
# map onto it) and whether it is in the cluster placement group.
%{ for h in hosts ~}
[[hosts]]
name = "${h.name}"
address = "${h.public_ip}"
private = "${h.private_ip}"
user = "ec2-user"
site = "${h.site}"
cluster = ${h.cluster}

%{ endfor ~}
